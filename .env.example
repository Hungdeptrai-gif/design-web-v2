# ---------------------------------------------------------------------------
# Thietkekythuat – biến môi trường (đặt trong Vercel → Settings → Environment Variables)
# ---------------------------------------------------------------------------

# BẮT BUỘC: mật khẩu vào trang /admin. Đặt chuỗi dài, khó đoán.
ADMIN_PIN=

# Kho dữ liệu (Upstash Redis) – Vercel TỰ ĐIỀN khi bạn thêm Upstash trong tab Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kho ảnh/bản vẽ tải lên (Vercel Blob) – Vercel TỰ ĐIỀN khi bạn thêm Blob trong tab Storage.
BLOB_READ_WRITE_TOKEN=
# Kho Blob mới của Vercel chỉ tạo BLOB_STORE_ID (đăng nhập OIDC tự động) — cũng được.

# Thông báo Zalo (không bắt buộc – cũng có thể nhập trong /admin → Kết nối Bot Zalo).
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# Thông báo qua Email bằng Resend (không bắt buộc).
RESEND_API_KEY=
NOTIFY_EMAIL=
# RESEND_FROM=Thietkekythuat <thongbao@ten-mien-cua-ban.vn>
